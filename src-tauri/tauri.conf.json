{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCRCTL",
  "version": "0.3.1",
  "identifier": "com.scrctl.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCRCTL",
        "url": "index.html",
        "width": 1100,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/LICENSE-scrcpy.txt",
      "resources/platform-tools/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
